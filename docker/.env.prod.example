# Production environment for docker-compose.prod.yml
# Copy to .env.prod next to the compose file and fill in the values.
#   cp .env.prod.example .env.prod

# --- Backend (FastAPI) ---
# Random string, 32+ chars. Generate: openssl rand -hex 32
BACKEND_SECRET_KEY=change-me-random-32-chars-min

# Keep sqlite unless you enable the Postgres profile (see compose comments).
# sqlite file lives in the backend-data volume; survives container recreation.
BACKEND_DATABASE_URL=sqlite:///./data/site.db

# debug mode: keep false in production
BACKEND_DEBUG=false

# Public site URL (CORS)
BACKEND_FRONTEND_URL=https://frants.tech

# --- Postgres (only if you enable the "postgres" profile in the compose file) ---
# POSTGRES_USER=siteuser
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=site
