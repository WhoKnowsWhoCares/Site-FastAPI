# Reproduce the backend/.env.example defaults for production
# Copy to docker/.env.production and adjust before `docker compose up`.

# App
DEBUG=false

# Security — REQUIRED: set a real random 32+ char secret
SECRET_KEY=change-me-to-random-string-32-chars-min

# Database (overridden by compose to sqlite:////app/data/site.db)
DATABASE_URL=sqlite:///./site.db

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Public site URL (used for OAuth redirects)
FRONTEND_URL=http://localhost

# Admin token for /api/admin/* endpoints — REQUIRED in production
ADMIN_TOKEN=change-me-admin-token
