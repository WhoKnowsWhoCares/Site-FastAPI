# Reproduce the backend/.env.example defaults for production
# Copy to docker/.env.production and adjust before `docker compose up`.

# App
DEBUG=true

# Security — REQUIRED: set a real random 32+ char secret
SECRET_KEY=change-me-to-random-string-32-chars-min

# Database credentials used by docker-compose interpolation (POSTGRES_*).
# Compose builds DATABASE_URL for the backend from these automatically.
# NOTE: compose reads interpolation overrides from docker/.env (next to
# docker-compose.yml), not from this file — copy the three POSTGRES_* lines
# there too if you change them.
POSTGRES_USER=siteuser
POSTGRES_PASSWORD=sitepass
POSTGRES_DB=site
# Effective value (set by compose; override only if needed):
# DATABASE_URL=postgresql+asyncpg://siteuser:sitepass@db:5432/site

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Public site URL (used for OAuth redirects)
FRONTEND_URL=http://localhost

# Admin token for /api/admin/* endpoints — REQUIRED in production
ADMIN_TOKEN=change-me-admin-token
